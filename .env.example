# Backend origin + version prefix. The browser never calls this directly —
# next.config.ts rewrites /api/:path* to it, so all client traffic is same-origin.
NEXT_PUBLIC_BASE_URL=http://localhost:3000/v1

# Websocket origin for realtime trade / dispute updates.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:3000

# Public origin of this app. Used for metadataBase and absolute OG image URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Google reCAPTCHA v2 site key (public half only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: analytics / error reporting public keys.
NEXT_PUBLIC_SENTRY_DSN=
