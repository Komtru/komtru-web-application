# Backend origin + version prefix. The browser never calls this directly —
# next.config.ts rewrites /api/:path* to it, so all client traffic is same-origin.
NEXT_PUBLIC_BASE_URL=http://localhost:3000/v1

# Socket.IO origin for realtime notifications and trade / dispute updates.
# A separate long-lived process from the Next.js app — not the /api rewrite,
# and not something a serverless function can host.
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:3000

# The handshake path, NOT socket.io's /socket.io default. Must match the
# backend's SOCKET_PATH exactly — a mismatch just 404s and retries forever.
NEXT_PUBLIC_WS_PATH=/socket

# The published terms version recorded against every signup. Bump when the
# terms change — it is sent to POST /auth/register and stored for audit.
NEXT_PUBLIC_TERMS_VERSION=2026-08-01

# Public origin of this app. Used for metadataBase and absolute OG image URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Google reCAPTCHA v2 site key (public half only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: analytics / error reporting public keys.
NEXT_PUBLIC_SENTRY_DSN=
